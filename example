local I = loadstring(game:HttpGet("https://raw.githubusercontent.com/zurtiedbritt-coder/Britts-Ui-Library/refs/heads/main/source"))()

I:KeyGate(function() -- key = Free

local W = I:Window({Name = "Britts Free UI", Size = UDim2.fromOffset(550, 600)})

-- Main tab, two columns
local T = W:Tab({Name = "Main"})
local L = T:Section({Name = "Features", Side = "left"})
local R = T:Section({Name = "Values", Side = "right"})

L:Toggle({Name = "Enabled", Flag = "ex_toggle", Default = false, Callback = function(v) print("toggle:", v) end})
 :Keybind({Default = Enum.KeyCode.V, Mode = "Toggle", Flag = "ex_key", Callback = function(v) print("key:", v) end})

L:Toggle({Name = "ESP", Flag = "ex_esp", Default = true, Callback = function(v) print("esp:", v) end})
 :Colorpicker({Flag = "ex_esp_color", Default = Color3.fromRGB(255, 45, 149), Callback = function(s) print(s.Color) end})

R:Slider({Name = "Speed", Flag = "ex_speed", Min = 0, Max = 200, Default = 16, Callback = function(v) print("speed:", v) end})
R:Dropdown({Name = "Mode", Flag = "ex_mode", Options = {"A", "B", "C"}, Default = "A", Callback = function(v) print("mode:", v) end})
R:Dropdown({Name = "Multi", Flag = "ex_multi", Options = {"X", "Y", "Z"}, Multi = true, Callback = function(v) print(table.concat(v, ",")) end})
R:Textbox({Name = "Name", Flag = "ex_name", Placeholder = "type...", Callback = function(v) print("box:", v) end})
R:Button({Name = "Fire", Callback = function() print("pressed") end})
R:Label({Name = "Status: ready"})
R:Divider({})

-- second tab with sub-tabs
local C = W:Tab({Name = "Combat", SubTabs = true})
local S1 = C:SubTab({Name = "Aim"})
local A1 = S1:Section({Name = "Aimbot", Side = "left"})
A1:Toggle({Name = "Aimbot", Flag = "ex_aim", Default = false, Callback = function(v) print(v) end})
A1:Slider({Name = "FOV", Flag = "ex_fov", Min = 10, Max = 500, Default = 120, Callback = function(v) print(v) end})

-- player list page
local P = W:Tab({Name = "Players"})
P:PlayerList({})

-- settings (themes, blur, glass, keybinds, close speed, mobile) + configs (save/load)
local Set = W:Tab({Name = "Settings"})
I:Configs(Set)
I:General(Set)

end)
