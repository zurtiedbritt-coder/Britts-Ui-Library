-- Britts Free UI v1.0.0 | key = Free
local I = loadstring(game:HttpGet("https://raw.githubusercontent.com/zurtiedbritt-coder/Britts-Ui-Library/refs/heads/main/source"))()

I:KeyGate(function() -- auto-remembers after first entry
I:QuickStart()       -- loader, then Home / Music / Playlists / Users / Settings

task.spawn(function()
    repeat task.wait() until I.MainWindow
    local W = I.MainWindow
    local T = W:Tab({Name = "My Tab"})
    local S = T:Section({Name = "Stuff", Side = "left"})
    S:Toggle({Name = "Enabled", Flag = "mytab_toggle", Default = false, Callback = function(v) print(v) end})
    S:Slider({Name = "Amount", Flag = "mytab_amount", Min = 0, Max = 100, Default = 20, Callback = function(v) print(v) end})
    S:Button({Name = "Go", Callback = function() print("go") end})
end)

end)
