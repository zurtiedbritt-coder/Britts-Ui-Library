    function Interface:KeyGate(onSuccess, keys)
        local valid = {}
        if type(keys) == "table" then valid = keys
        elseif keys ~= nil then valid = {tostring(keys)}
        else valid = {"Free"} end
        local gate = { Done = false, Key = nil }
        local keyFile = gamepath .. "key.txt"
        local saved = nil
        pcall(function() if isfile(keyFile) then saved = readfile(keyFile) end end)
        local function isValid(k)
            for _, v in ipairs(valid) do if k == v then return true end end
            return false
        end
        local holder = Framework:New("ScreenGui", {
            Parent = safeHui(),
            Name = "KeyGate",
            IgnoreGuiInset = Enum.ScreenInsets.DeviceSafeInsets,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            DisplayOrder = 150,
        })
        local bg = glassCard(holder, 320, 226)
        local function pass(key)
            gate.Done = true
            gate.Key = key
            pcall(function() writefile(keyFile, key) end)
            holder:Destroy()
            if onSuccess then task.spawn(onSuccess) end
        end
        Framework:New("TextLabel", {
            Parent = bg, BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 14), Size = UDim2.new(1, 0, 0, 24),
            FontFace = Interface.Font, TextSize = 16, Text = "Britts Free UI",
        }):Add({TextColor3 = "Active"})
        Framework:New("TextLabel", {
            Parent = bg, BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 38), Size = UDim2.new(1, 0, 0, 14),
            FontFace = Interface.Font, TextSize = 11, Text = "build 1.0.0",
        }):Add({TextColor3 = "Inactive"})
        local x = Framework:New("TextButton", {
            Parent = bg, Position = UDim2.new(1, -28, 0, 6), Size = UDim2.new(0, 22, 0, 22),
            FontFace = Interface.Font, TextSize = 13, Text = "X", AutoButtonColor = false,
            BackgroundTransparency = 1,
        }):Add({TextColor3 = "Inactive"})
        Framework:Connect(x.MouseButton1Click, function() holder:Destroy() end)
        local box = Framework:New("TextBox", {
            Parent = bg, Position = UDim2.new(0, 20, 0, 66), Size = UDim2.new(1, -40, 0, 32),
            FontFace = Interface.Font, TextSize = 13, Text = "", PlaceholderText = "Enter key...",
            ClearTextOnFocus = false,
        }):Add({TextColor3 = "Active", BackgroundColor3 = "Middle", PlaceholderColor3 = "Inactive"})
        Framework:New("UICorner", { Parent = box, CornerRadius = UDim.new(0, 4) })
        local msg = Framework:New("TextLabel", {
            Parent = bg, BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 0, 104), Size = UDim2.new(1, 0, 0, 16),
            FontFace = Interface.Font, TextSize = 12, Text = "",
        }):Add({TextColor3 = "Inactive"})
        local btn = Framework:New("TextButton", {
            Parent = bg, Position = UDim2.new(0, 20, 0, 128), Size = UDim2.new(1, -40, 0, 32),
            FontFace = Interface.Font, TextSize = 13, Text = "Unlock", AutoButtonColor = false,
        }):Add({BackgroundColor3 = "Accent", TextColor3 = "Middle"})
        Framework:New("UICorner", { Parent = btn, CornerRadius = UDim.new(0, 4) })
        Framework:New("TextLabel", {
            Parent = bg, BackgroundTransparency = 1,
            Position = UDim2.new(0, 0, 1, -22), Size = UDim2.new(1, 0, 0, 14),
            FontFace = Interface.Font, TextSize = 11, Text = "Need a key? Ask for one.",
        }):Add({TextColor3 = "Inactive"})
        local basePos = bg.Position
        local function shake()
            task.spawn(function()
                for _, dx in ipairs({-8, 8, -5, 5, 0}) do
                    Framework:Tween(bg, {Position = UDim2.new(0.5, dx, 0.5, 0)}, 0.05, Enum.EasingStyle.Linear, Enum.EasingDirection.Out)
                    task.wait(0.055)
                end
                bg.Position = basePos
            end)
        end
        local function try()
            local k = tostring(box.Text or ""):gsub("^%s+", ""):gsub("%s+$", "")
            if isValid(k) then
                msg.Text = "Welcome"
                task.wait(0.4)
                pass(k)
            else
                msg.Text = "Invalid key"
                shake()
            end
        end
        Framework:Connect(btn.MouseButton1Click, function() task.spawn(try) end)
        Framework:Connect(box.FocusLost, function(enter) if enter then task.spawn(try) end end)
        if saved and isValid(tostring(saved):gsub("%s+", "")) then
            msg.Text = "Welcome back"
            task.spawn(function()
                task.wait(0.6)
                if bg._obj.Parent then pass(tostring(saved):gsub("%s+", "")) end
            end)
        end
        return gate
    end;
end;

