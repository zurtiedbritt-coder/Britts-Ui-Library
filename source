do -- Skyboxes
    local cache = {};
    function Assets.Skyboxes:Require(folder, face)
        if not cache[folder] then
            cache[folder] = tostring(os.time())
        end
        local tag = cache[folder]
        local path = ("bfui/Skyboxes/%s/%s_%s.tex"):format(folder, face, tag)
        local url  = ("https://raw.githubusercontent.com/shloopyp/s.win/main/Skyboxes/%s/%s.tex"):format(folder, face)
        writefile(path, game:HttpGet(url))
        return getcustomasset(path)
    end;
end;

do -- Images
    function Assets.Images:Require(name)
        local ok, res = pcall(function()
            local f = "bfui/Images/" .. name .. ".png";
            if not isfile(f) then
                writefile(f, game:HttpGet("https://raw.githubusercontent.com/shloopyp/s.win/main/Images/" .. name .. ".png", true));
            end;
            return getcustomasset(f);
        end)
        if ok and res and res ~= "" then return res end
        return "rbxasset://textures/ui/GuiImagePlaceholder.png";
