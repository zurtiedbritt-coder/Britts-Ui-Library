            local absPos, absSize = KeybindBg.AbsolutePosition, KeybindBg.AbsoluteSize
            ModeBox.Position = UDim2.new(0, absPos.X + 55, 0, absPos.Y + absSize.Y/2 - 30 + 110)
            ModeBox.BackgroundTransparency = 1
