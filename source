                pcall(function()
                    if not isfolder(gamepath .. "Playlists") then makefolder(gamepath .. "Playlists") end
                    writefile(plPath(name), table.concat(songs, "\n"))
                end)
                pickList:Refresh(plScan())
                Interface:Notification("Saved playlist [" .. name .. "].", 3)
            end
        end}):Button({Name = "Open", Callback = function()
            local sel = Interface.Flags["pl_pick"]
            if type(sel) == "table" then sel = sel[1] end
            if sel and sel ~= "" then
                local q = {}
                pcall(function()
                    local raw = readfile(plPath(sel))
                    for _, line in ipairs(string.split(raw, "\n")) do
                        line = line:gsub("^%s+", ""):gsub("%s+$", "")
                        if line ~= "" then table.insert(q, line) end
                    end
                end)
                if #q > 0 then
                    Interface.MusicQueue = q
                    Interface:Notification("Queue: " .. sel .. " (" .. #q .. ")", 3)
                else
                    Interface:Notification("Playlist empty.", 3)
                end
            end
        end});
        PZ:Button({Name = "Add Songs", Callback = function()
            local sel = Interface.Flags["pl_pick"]
            if type(sel) == "table" then sel = sel[1] end
            local songs = Interface.Flags["pl_songs"]
            if sel and sel ~= "" and type(songs) == "table" and #songs > 0 then
                local have = {}
                pcall(function()
                    local raw = readfile(plPath(sel))
                    for _, line in ipairs(string.split(raw, "\n")) do
                        line = line:gsub("^%s+", ""):gsub("%s+$", "")
                        if line ~= "" then have[line] = true end
                    end
                end)
                for _, s in ipairs(songs) do have[s] = true end
                local out = {}
                for _, f in ipairs(songScan()) do if have[f] then table.insert(out, f) end end
                for k in pairs(have) do
                    local found = false
                    for _, f in ipairs(out) do if f == k then found = true break end end
                    if not found then table.insert(out, k) end
                end
                pcall(function() writefile(plPath(sel), table.concat(out, "\n")) end)
                Interface:Notification("Added to [" .. sel .. "].", 3)
            end
        end});
        PZ:Button({Name = "Unload", Callback = function()
            Interface.MusicQueue = nil
            Interface:Notification("Queue cleared.", 3)
        end}):Button({Name = "Refresh", Callback = function()
            pickList:Refresh(plScan())
            songList:Refresh(songScan())
        end});
        PZ:Textbox({Name = "Share", Flag = "pl_share", Placeholder = "paste playlist..."});
        PZ:Button({Name = "Copy", Callback = function()
            local songs = Interface.Flags["pl_songs"]
            if setclipboard and type(songs) == "table" and #songs > 0 then
                setclipboard(table.concat(songs, "\n"))
                Interface:Notification("Copied playlist.", 3)
            end
        end}):Button({Name = "Import", Callback = function()
            local name = Interface.Flags["pl_name"]
            local s = Interface.Flags["pl_share"]
            if name and name ~= "" and s and s ~= "" then
                local q = {}
                for _, line in ipairs(string.split(s, "\n")) do
                    line = line:gsub("^%s+", ""):gsub("%s+$", "")
                    if line ~= "" then table.insert(q, line) end
                end
                if #q > 0 then
                    pcall(function()
                        if not isfolder(gamepath .. "Playlists") then makefolder(gamepath .. "Playlists") end
                        writefile(plPath(name), table.concat(q, "\n"))
                    end)
                    pickList:Refresh(plScan())
                    Interface:Notification("Imported [" .. name .. "].", 3)
                end
            end
        end});
        local US = W:Tab({Name = "Users"})
        local UB = US:Section({Name = "Library Users", Side = "left"})
        local uCount = UB:Label({Name = "0 online"})
        local uList = UB:ListBox({Flag = "bfui_users", Options = {"none"}})
        local function scanUsers()
            local names = {}
            for _, p in ipairs(game:GetService("Players"):GetPlayers()) do
                local ok, v = pcall(function() return p:GetAttribute("BFUI") end)
                if ok and v then
                    table.insert(names, p.DisplayName .. " (@" .. p.Name .. ")")
                end
            end
            table.sort(names)
            return names
        end
        UB:Button({Name = "Refresh", Callback = function()
            local names = scanUsers()
            uCount:SetText(#names .. " online")
            uList:Refresh(#names > 0 and names or {"none"})
        end});
        local Set = W:Tab({Name = "Settings"})
        Interface:Configs(Set)
        Interface:General(Set)
        end)
        return nil
    end;
end;

