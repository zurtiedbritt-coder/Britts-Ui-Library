            if nowT - lastPrevAt < 0.6 then
                lastPrevAt = 0
                local idx = #files
                for i, f in ipairs(files) do
                    if f == currentTrack then idx = ((i - 2) % #files) + 1 break end
                end
                playFile(files[idx])
            else
                lastPrevAt = nowT
                if currentTrack then
                    pcall(function()
                        sound.TimePosition = 0
                        if not sound.Playing then sound:Play() end
                    end)
                else
                    playFile(files[#files])
                end
            end
        end
