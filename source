            syncMiniSize()
        end});
        Framework:Connect(Services.RunService.RenderStepped, function()
            if Interface.VizOn == false then
                pcall(function() barHolder.Visible = false end)
                return
            end
            pcall(function() barHolder.Visible = true end)
            local loud = 0
            local playing = false
            pcall(function()
                loud = sound.PlaybackLoudness
                playing = sound.Playing
            end)
            local t = os.clock()
            local amp = math.clamp(loud / 1000, 0, 1)
            amp = math.clamp(amp * 1.4, 0, 1) ^ 0.7
            local secW, miniWpx = 7, 8
            pcall(function()
                secW = math.max(3, (barHolder.AbsoluteSize.X - 46) / 24)
            end)
            pcall(function()
                local mbh = Interface.MiniBars and Interface.MiniBars.holder
                if mbh then miniWpx = math.max(3, (mbh.AbsoluteSize.X - 22) / 12) end
            end)
            for i, b in ipairs(bars) do
                local target = 4
                if playing then
                    local wobble = 0.8 + 0.2 * math.sin(t * 9 + i * 0.9)
                    target = 4 + amp * 52 * wobble
                end
                local rate = (target > levels[i]) and 0.65 or 0.18
                levels[i] = levels[i] + (target - levels[i]) * rate
                pcall(function() b.Size = UDim2.new(0, secW, 0, levels[i]) end)
            end
            local mmb = Interface.MiniBars
            if mmb and mmb.bars then
